{
  // Cloudflare Worker: serves ./public and the /api used by homosapiens.ro/update
  "name": "homosapienss",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "HsStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HsStore"] }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Contact form: sends each message to the team inbox (needs Email Routing on homosapiens.ro
  // and the inbox verified as a destination address; until then messages wait on /update).
  "send_email": [{ "name": "MAILER", "destination_address": "thehomosapiens123@gmail.com" }],
  "observability": { "enabled": true }
}
